# Hand-authored version file; see rocMLIRConfig.cmake.
set(PACKAGE_VERSION "2.0.0")

if(PACKAGE_FIND_VERSION_RANGE)
    if(NOT (PACKAGE_FIND_VERSION_RANGE_MIN VERSION_LEQUAL "2.0.0"
            AND "2.0.0" VERSION_LESS_EQUAL PACKAGE_FIND_VERSION_RANGE_MAX))
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
elseif(PACKAGE_FIND_VERSION VERSION_GREATER "2.0.0")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
